{
  "version": "blind-v1",
  "seed": 20261031,
  "input_features": ["unit_id", "text", "segment_id", "start", "end"],
  "forbidden_inputs": ["video_frames", "online_subtitles", "slide_times", "chapters", "gold", "source_map", "reference_notes"],
  "page_order_prior": false,
  "chunk_seconds": 40,
  "semantic_weight": 0.7,
  "lexical_weight": 0.3,
  "automatic_score_floor": 0.35,
  "automatic_margin_floor": 0.04,
  "top_k": 3,
  "evaluation_first_second": 60,
  "evaluation_step_seconds": 120,
  "evaluation_context_seconds": 20,
  "asr_model": "small",
  "asr_device": "cpu",
  "asr_compute_type": "int8",
  "embedding_model": "sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2",
  "summary_language": "zh-CN",
  "summary_max_topics": 6,
  "summary_batch_characters": 7000,
  "notes_rubric": ["core_coverage", "explanation", "useful_examples", "pitfalls_and_limits", "faithfulness", "traceability"],
  "rubric_score_per_dimension": [0, 1, 2, 3, 4],
  "result_policy": "Freeze predictions and generated notes before opening evaluation-only evidence. Any later tuning is a separately labeled development run."
}
